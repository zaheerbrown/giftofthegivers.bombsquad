@model GiftOfTheGivers.Models.Donation
@{
    ViewData["Title"] = "Tax Certificate";
}

<div class="container my-4">
    <div class="card border-dark shadow-lg">
        <div class="card-body p-5">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h2 class="text-success fw-bold mb-0">GIFT OF THE GIVERS FOUNDATION</h2>
                    <p class="text-muted mb-0">Section 18A Tax Deductible Receipt</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-success fs-6">Verified Issued</span>
                </div>
            </div>

            <div class="row my-4">
                <div class="col-sm-6">
                    <p class="mb-1"><strong>Certificate Number:</strong> @Model.CertificateNumber</p>
                    <p class="mb-1"><strong>Date Issued:</strong> @Model.DateDonated.ToString("dd MMMM yyyy HH:mm")</p>
                    <p class="mb-1"><strong>Donor Name:</strong> @Model.DonorName</p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <p class="mb-1"><strong>Donation Amount:</strong> @Model.Currency @Model.Amount.ToString("N2")</p>
                    <p class="mb-1"><strong>Frequency:</strong> @Model.DonationType</p>
                    <p class="mb-1"><strong>Tax Ref:</strong> @(string.IsNullOrEmpty(Model.TaxReferenceNumber) ? "N/A" : Model.TaxReferenceNumber)</p>
                </div>
            </div>

            <div class="alert alert-light border text-center my-4">
                <small class="text-muted">This certificate confirms receipt of funds for emergency disaster relief under Section 18A of the Income Tax Act.</small>
            </div>

            <div class="text-center mt-4">
                <button onclick="window.print()" class="btn btn-outline-dark"><i class="bi bi-printer me-2"></i>Print / Download Receipt</button>
                <a asp-action="Index" class="btn btn-gotg-primary ms-2">Make Another Donation</a>
            </div>
        </div>
    </div>
</div>