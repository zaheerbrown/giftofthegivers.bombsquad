@model IEnumerable<GiftOfTheGivers.Models.Donation>
@{
    ViewData["Title"] = "Recent Donations";
}

@if (TempData["FunctionStatus"] is string status)
{
    <div class="alert alert-success">@status</div>
}
@if (TempData["FunctionError"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Recent Donations</h2>
    <a asp-controller="Donation" asp-action="Create" class="btn btn-primary">New Donation</a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
            <tr><th>Donor</th><th>Amount</th><th>Type</th><th>Date</th><th>Certificate</th></tr>
        </thead>
        <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@(item.IsAnonymous ? "Anonymous" : item.DonorName)</td>
                    <td class="fw-bold">@item.Currency @item.Amount.ToString("N2")</td>
                    <td>@item.DonationType</td>
                    <td>@item.DateDonated.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.CertificateNumber))
                        {
                            <a asp-action="Certificate" asp-route-id="@item.Id">@item.CertificateNumber</a>
                        }
                        else
                        {
                            <span class="text-muted">Not generated</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5" class="text-center text-muted py-4">No donations recorded yet.</td></tr>
        }
        </tbody>
    </table>
</div>
